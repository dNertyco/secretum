# Copy to .env and adjust. Never commit real secrets.
SECRETUM_HTTP_ADDR=:8080
SECRETUM_LOG_LEVEL=info
SECRETUM_SHUTDOWN_TIMEOUT=10s

SECRETUM_DATABASE_URL=postgres://secretum:change-me@postgres:5432/secretum?sslmode=disable
SECRETUM_MIGRATE_ON_START=true
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
SECRETUM_JWT_SECRET=replace-with-at-least-32-random-bytes!!
SECRETUM_TOKEN_TTL=15m
SECRETUM_ALLOW_REGISTRATION=true
SECRETUM_LOGIN_RATE_PER_MINUTE=10

# Master keys as id:base64(32 random bytes), comma-separated; generate with
# `openssl rand -base64 32`. Keep retired keys listed until all data keys are
# re-wrapped. In production keep master keys in a KMS, not in .env.
SECRETUM_MASTER_KEYS=k1:REPLACE+WITH+openssl+rand+base64+32+output=
SECRETUM_ACTIVE_KEY_ID=k1
SECRETUM_MAX_UPLOAD_BYTES=33554432

# The local SeaweedFS from docker-compose accepts any credentials.
SECRETUM_S3_ENDPOINT=s3:8333
SECRETUM_S3_ACCESS_KEY=secretum
SECRETUM_S3_SECRET_KEY=change-me-too
SECRETUM_S3_BUCKET=secretum
SECRETUM_S3_USE_SSL=false

POSTGRES_USER=secretum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secretum
